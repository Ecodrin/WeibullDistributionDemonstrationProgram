flowchart TD
    A([Запуск программы]) --> B[Задать параметры Weibull<br/>k и lambda]
    B --> C{Выбрать действие}

    C -->|Генерация| D[Сгенерировать набор<br/>нечётких величин]
    D --> E[Добавить интервалы<br/>в текущий набор]
    E --> F[Обновить список и<br/>общий график]

    C -->|Арифметика| G[Выбрать два интервала<br/>и операцию]
    G --> H[Выполнить операцию<br/>над интервалами]
    H --> I[Добавить результат<br/>в набор]
    I --> F

    C -->|Фильтрация alpha| J[Задать alpha]
    J --> K[Вычислить принадлежность<br/>центра каждого интервала]
    K --> L[Показать интервалы,<br/>прошедшие фильтр]

    C -->|Кластеризация| M[Выбрать количество кластеров<br/>и метрику]
    M --> N[Построить матрицу расстояний]
    N --> O[Выполнить алгоритм k-medoids]
    O --> P[Построить график кластеров<br/>для всего набора]
    P --> Q[Задать alpha для второго графика]
    Q --> R[Отфильтровать интервалы<br/>по принадлежности]
    R --> S[Повторно выполнить<br/>кластеризацию отфильтрованной части]
    S --> T[Построить второй график]

    F --> C
    L --> C
    T --> C
    C -->|Очистка| U[Удалить текущий набор]
    U --> F
    C -->|Выход| V([Завершение])
